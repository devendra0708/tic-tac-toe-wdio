{
  "name": "tic-tac-toe-wdio",
  "version": "1.0.0",
  "description": "WebdriverIO + TypeScript E2E tests for Tic-Tac-Toe",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:auth": "wdio run wdio.conf.ts --spec test/specs/auth.spec.ts",
    "test:game": "wdio run wdio.conf.ts --spec test/specs/game.spec.ts",
    "test:profile": "wdio run wdio.conf.ts --spec test/specs/profile.spec.ts",
    "test:history": "wdio run wdio.conf.ts --spec test/specs/history.spec.ts",
    "test:settings": "wdio run wdio.conf.ts --spec test/specs/settings.spec.ts",
    "test:i18n": "wdio run wdio.conf.ts --spec test/specs/i18n.spec.ts",
    "test:e2e": "wdio run wdio.conf.ts --spec test/specs/e2e.spec.ts",
    "test:nav": "wdio run wdio.conf.ts --spec test/specs/nav.spec.ts",
    "serve": "npx http-server app -p 8080 -c-1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:test": "docker compose run --rm --build tests",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/cli": "^9.12.4",
    "@wdio/local-runner": "^9.12.4",
    "@wdio/mocha-framework": "^9.12.3",
    "@wdio/spec-reporter": "^9.12.3",
    "@wdio/static-server-service": "^9.30.1",
    "@wdio/types": "^9.12.3",
    "allure-commandline": "^2.43.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "expect-webdriverio": "^5.4.1",
    "http-server": "^14.1.1",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
