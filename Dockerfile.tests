FROM node:22-bookworm-slim

RUN apt-get update && \
  apt-get install -y --no-install-recommends \
    chromium chromium-driver \
    ca-certificates fonts-liberation \
    default-jre-headless && \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json wdio.conf.ts ./
COPY app ./app
COPY test ./test

ENV CI=true \
  CHROME_BIN=/usr/bin/chromium \
  CHROMEDRIVER_BIN=/usr/bin/chromedriver

# Run the suite, then build Allure HTML inside the container (no host Java).
# Preserve the WDIO exit code so a red suite still fails the compose run.
CMD ["sh", "-c", "npx wdio run ./wdio.conf.ts; status=$?; npx allure generate allure-results --clean -o allure-report; exit $status"]
